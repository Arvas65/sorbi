{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python .claude/hooks/kapi.py --acilis"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "python .claude/hooks/kapi.py --dosya"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python .claude/hooks/kapi.py --kapanis"}
        ]
      }
    ]
  }
}
